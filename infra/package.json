{
  "name": "@oddssea/infra",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff Oddssea-dev-Data Oddssea-dev-App",
    "deploy:data": "cdk deploy Oddssea-dev-Data --require-approval never",
    "deploy:app": "cdk deploy Oddssea-dev-App --require-approval never",
    "migrate": "bash ../scripts/run-migrations.sh Oddssea-dev-Data",
    "deploy": "npm run deploy:data && npm run migrate && npm run deploy:app",
    "deploy:cicd": "cdk deploy Oddssea-dev-Cicd",
    "bootstrap": "cdk bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
